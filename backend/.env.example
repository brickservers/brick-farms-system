ENV=dev

# Postgres / PostGIS / Timescale
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=brickfarm
DB_USER=brickfarm
DB_PASS=brickfarm_pass

# JWT / Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# S3/MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=brickfarm
S3_REGION=us-east-1
S3_SECURE=false

# Redis (cache/queue)
REDIS_URL=redis://127.0.0.1:6379/0

# Multitenancy
DEFAULT_PLAN=enterprise

# Email notifications (Zoho Mail)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=sprout@brickfarms.ng
SMTP_PASS=
SMTP_FROM_EMAIL=sprout@brickfarms.ng
SMTP_FROM_NAME=BrickFarms DAP
SMTP_USE_TLS=true

# SMS notifications (provider to be selected)
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_FROM=BrickFarms

# Flutterwave v4 payments
FLUTTERWAVE_API_BASE=https://api.flutterwave.com
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_REDIRECT_URL=http://localhost:5173/settings

# CORS
CORS_ORIGINS=http://localhost:5173

# Notes for local docker-compose
# If you use `docker compose up` in backend/ this will start a TimescaleDB instance with the
# credentials above. Run migrations with `alembic upgrade head` (or via the CI workflow).
