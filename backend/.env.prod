# JWT / Auth - replace with a long random secret in production
JWT_SECRET=prod-secret-change-me-in-production-uuid-abc12345xyz
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# S3/MinIO (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_SECURE=false

# Redis remains on the app server until we move it to a managed/dedicated cache.
REDIS_URL=redis://127.0.0.1:6380/0

# CORS
CORS_ORIGINS=["https://app.brickfarms.ng","https://www.app.brickfarms.ng"]

# Multitenancy
DEFAULT_PLAN=enterprise

# Email notifications (Zoho Mail). Put SMTP_PASS in backend/.env.prod.local.
