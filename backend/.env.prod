ENV=production

# Managed PostgreSQL / PostGIS
DB_HOST=ls-8057ed7a6e1ab0e3c4a26c01d143c38562699461.c6zyssamuf5b.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=brickfarm
